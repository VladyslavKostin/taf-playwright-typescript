{
  "name": "taf-playwright-typescript",
  "version": "1.0.0",
  "description": "Sample Playwright + TypeScript test automation framework using the Intent-Flow-Component pattern, tested against automationexercise.com",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:component": "playwright test --project=component",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "report": "playwright show-report",
    "report:coverage": "tsx scripts/coverage-report.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@faker-js/faker": "^9.2.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
